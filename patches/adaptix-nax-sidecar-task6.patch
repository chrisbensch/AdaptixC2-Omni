index 0000000..4b38ee5
--- /dev/null
+++ b/pl_build_payload_test.go
@@ -0,0 +1,110 @@
+package main
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+
+	adaptix "github.com/Adaptix-Framework/axc2"
+	naxbuilder "github.com/entropy-z/AdaptixC2-Omni/sidecar/nax-builder/naxbuilder"
+)
+
+// fakeSidecarBuilder starts an in-process server-side stub that replies to one
+// request with canned components, so buildViaSidecar can be tested end-to-end
+// without any compiler or real source tree.
+func fakeSidecarBuilder(t *testing.T, sockPath string) {
+	l, err := net.Listen("unix", sockPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = l.Close() })
+	go func() {
+		for {
+			conn, err := l.Accept()
+			if err != nil {
+				return
+			}
+			go func(conn net.Conn) {
+				defer conn.Close()
+				var req naxbuilder.NaxBuildRequest
+				if err := naxbuilder.ReadFrame(conn, &req, naxbuilder.MaxFrameBytes); err != nil {
+					return
+				}
+				resp := &naxbuilder.NaxBuildResponse{
+					OK:       true,
+					Filename: "nax.x64.bin",
+					Components: map[string][]byte{
+						"loader":  []byte("L"),
+						"beacon": []byte("B"),
+						"pdata":  []byte{},
+						"xdata":  []byte{},
+						"textRva": []byte("4096"),
+					},
+					Flags:    "0x0000",
+					StompDll: "chakra.dll",
+				}
+				_ = naxbuilder.WriteFrame(conn, resp)
+			}(conn)
+		}
+	}()
+}
+
+// TestMapBuildProfileThroughSidecar wires buildViaSidecar at an in-process fake
+// builder (via ModuleDir/nax_builder_socket) and asserts the repacked output equals
+// packNaxBin(loader, beacon, pdata, xdata, textRva, 0, stompDll) of the canned parts.
+func TestMapBuildProfileThroughSidecar(t *testing.T) {
+	// Point buildViaSidecar at the fake builder: set ModuleDir to a temp dir whose
+	// nax_builder_socket contains the fake builder's socket path.
+	dir := t.TempDir()
+	sockPath := "/tmp/nax_sidecar_test.sock" // short path: macOS sun_path is capped at 104 bytes
+	if err := os.WriteFile(filepath.Join(dir, "nax_builder_socket"), []byte(sockPath), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	origModuleDir := ModuleDir
+	ModuleDir = dir
+	t.Cleanup(func() {
+		ModuleDir = origModuleDir
+		_ = os.Remove(sockPath)
+	})
+
+	fakeSidecarBuilder(t, sockPath)
+
+	profile := adaptix.BuildProfile{
+		AgentConfig:    `{"sleep":10,"jitter":30,"gate_apis":[],"output_format":"bin"}`,
+		ListenerProfiles: []adaptix.TransportProfile{
+			{Watermark: "a04a4178", Profile: []byte(`{"hosts":["1.2.3.4:443"],"ssl":true,"encrypt_key":"00112233445566778899aabbccddeeff","post":{"uris":["/api/v1/status"]}}`)},
+		},
+	}
+	_ = profile
+
+	// Build the request exactly like BuildPayload does, then send it through the sidecar.
+	req := &naxbuilder.NaxBuildRequest{
+		Transport:    "http",
+		OutputFormat: "bin",
+	}
+	payload, _, err := buildViaSidecar(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// The repacked payload must equal packNaxBin(loader, beacon, pdata, xdata, textRva, 0, chakra.dll)
+	// of the fake builder's canned components.
+	want := packNaxBin([]byte("L"), []byte("B"), []byte{}, []byte{}, 0x4096, 0, "chakra.dll")
+	if len(payload) != len(want) {
+		t.Fatalf("packed payload len = %d, want %d", len(payload), len(want))
+	}
+	for i := range want {
+		if payload[i] != want[i] {
+			t.Fatalf("packed payload[%d] = 0x%02x, want 0x%02x (idx %d)", i, payload[i], want[i], i)
+		}
+	}
+}
+
+func TestBuildViaSidecarBuilderAbsent(t *testing.T) {
+	// No listener on this path -> buildViaSidecar must return a clear error.
+	_, _, err := buildViaSidecar(&naxbuilder.NaxBuildRequest{Transport: "http", OutputFormat: "bin"})
+	if err == nil {
+		t.Fatal("expected builder-absence error")
+	}
+}
diff --git a/pl_nax_sidecar.go b/pl_nax_sidecar.go
new file mode 100644
index 0000000..8c26ac4
--- /dev/null
+++ b/pl_nax_sidecar.go
@@ -0,0 +1,48 @@
+package main
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+
+	naxbuilder "github.com/entropy-z/AdaptixC2-Omni/sidecar/nax-builder/naxbuilder"
+)
+
+// buildViaSidecar dials the sidecar builder over its Unix socket, sends the
+// fully-derived *naxbuilder.NaxBuildRequest (which carries the generated Config.h /
+// Config_profile.h / Config_sleepmask.h + the build input), reads the components
+// response, and repacks with the in-process packNaxBin(...). It never invokes a
+// compiler or touches a source tree — all native compilation happens in the sidecar.
+//
+// The socket path is resolved the usual way (ModuleDir/nax_builder_socket, or the
+// /run/nax/builder.sock fallback — see naxbuilder.ResolveSocketPath).
+func buildViaSidecar(req *naxbuilder.NaxBuildRequest) ([]byte, string, error) {
+	client := naxbuilder.New(naxbuilder.ResolveSocketPath(ModuleDir))
+	resp, err := client.Build(req)
+	if err != nil {
+		return nil, "", err
+	}
+	if resp == nil || !resp.OK {
+		return nil, "", fmt.Errorf("nonameax: BuildPayload: builder returned no payload")
+	}
+
+	loader := resp.Components["loader"]
+	beacon := resp.Components["beacon"]
+	pdata := resp.Components["pdata"]
+	xdata := resp.Components["xdata"]
+
+	// flags: "0x%04x" (with 0x prefix). textRva: hex string, no 0x prefix (match
+	// readTextRVA — fmt.Sscanf("%x")).
+	flags, _ := strconv.ParseUint(strings.TrimPrefix(resp.Flags, "0x"), 16, 32)
+	var textRva uint32
+	if raw := strings.TrimSpace(string(resp.Components["textRva"])); raw != "" {
+		_, _ = fmt.Sscanf(raw, "%x", &textRva)
+	}
+
+	dll := resp.StompDll
+	if dll == "" {
+		dll = "chakra.dll"
+	}
+
+	return packNaxBin(loader, beacon, pdata, xdata, textRva, uint32(flags), dll), resp.Filename, nil
+}
