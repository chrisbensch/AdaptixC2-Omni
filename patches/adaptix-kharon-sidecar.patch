+// TestKharonIndexMappers covers the syscall / bypass / sleep-mask string mappers.
+func TestKharonIndexMappers(t *testing.T) {
+	if got := syscallIndex("Stack Spoof + Indirect"); got != 2 {
+		t.Errorf("syscallIndex = %d, want 2", got)
+	}
+	if got := syscallIndex("Stack Spoof"); got != 1 {
+		t.Errorf("syscallIndex = %d, want 1", got)
+	}
+	if got := syscallIndex(""); got != 0 {
+		t.Errorf("syscallIndex = %d, want 0", got)
+	}
+
+	if got := bypassIndex("AMSI + ETW"); got != 0x3 {
+		t.Errorf("bypassIndex = 0x%x, want 0x3", got)
+	}
+	if got := bypassIndex("none"); got != 0x0 {
+		t.Errorf("bypassIndex = 0x%x, want 0x0", got)
+	}
+
+	if got := sleepMaskIndex("timer"); got != 1 {
+		t.Errorf("sleepMaskIndex = %d, want 1", got)
+	}
+	if got := sleepMaskIndex("POOLING"); got != 2 {
+		t.Errorf("sleepMaskIndex = %d, want 2", got)
+	}
+	if got := sleepMaskIndex(""); got != 3 {
+		t.Errorf("sleepMaskIndex = %d, want 3", got)
+	}
+}

