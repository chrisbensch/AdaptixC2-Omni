+// TestKharonOutputFormatMapper covers the Format -> OutputFormat mapping.
+func TestKharonOutputFormatMapper(t *testing.T) {
+	cases := map[string]string{
+		"Exe":   "exe",
+		"Dll":   "dll",
+		"Svc":   "svc",
+		"Bin":   "bin",
+		"":      "bin",
+		"WEIRD": "bin",
+	}
+	for in, want := range cases {
+		if got := kharonOutputFormat(in); got != want {
+			t.Errorf("kharonOutputFormat(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
