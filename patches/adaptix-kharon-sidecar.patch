--- /dev/null	2026-08-29 22:48:27
+++ b/agent_kharon/src_server/pl_kharon_sidecar.go	2026-08-29 22:34:00
@@ -0,0 +1,86 @@
+package main
+
+import (
+	"fmt"
+	"strings"
+
+	kharonbuilder "github.com/entropy-z/AdaptixC2-Omni/sidecar/kharon-builder/kharonbuilder"
+)
+
+// buildViaSidecar dials the Kharon payload builder sidecar over its Unix socket,
+// sends the fully-derived *kharonbuilder.KharonBuildRequest (which carries the
+// server-derived make variables + build selection), reads the compiled payload
+// back, and returns it with the output filename. It never invokes a compiler or
+// touches a source tree — all native compilation (the src_beacon make + optional
+// src_loader clang++) happens in the sidecar.
+//
+// The socket path is resolved the usual way (ModuleDir/kharon_builder_socket, or
+// the /run/kharon/builder.sock fallback — see kharonbuilder.ResolveSocketPath).
+func buildViaSidecar(req *kharonbuilder.KharonBuildRequest) ([]byte, string, error) {
+	client := kharonbuilder.New(kharonbuilder.ResolveSocketPath(ModuleDir))
+	resp, err := client.Build(req)
+	if err != nil {
+		return nil, "", err
+	}
+	if resp == nil || !resp.OK {
+		return nil, "", fmt.Errorf("kharon: buildViaSidecar: builder returned no payload")
+	}
+	return resp.Payload, resp.Filename, nil
+}
+
+// kharonOutputFormat maps the operator-facing Format string (as sent by the
+// client: "Exe"/"Dll"/"Svc"/"Bin") onto the kharonbuilder OutputFormat values
+// ("exe"/"dll"/"svc"/"bin"). Anything else (including the empty string) is
+// treated as a raw PIC beacon ("bin"), matching the in-server default.
+func kharonOutputFormat(format string) string {
+	switch format {
+	case "Exe":
+		return "exe"
+	case "Dll":
+		return "dll"
+	case "Svc":
+		return "svc"
+	default:
+		return "bin"
+	}
+}
+
+// syscallIndex maps the syscall-method string onto the KH_SYSCALL value the
+// Makefile expects (0 = none, 1 = stack spoof, 2 = stack spoof + indirect).
+func syscallIndex(s string) int {
+	switch s {
+	case "Stack Spoof + Indirect":
+		return 2
+	case "Stack Spoof":
+		return 1
+	default:
+		return 0
+	}
+}
+
+// bypassIndex maps the AMSI/ETW-bypass string onto the KH_AMSI_ETW_BYPASS value.
+func bypassIndex(s string) int {
+	switch s {
+	case "AMSI":
+		return 0x1
+	case "ETW":
+		return 0x2
+	case "AMSI + ETW":
+		return 0x3
+	default:
+		return 0x0
+	}
+}
+
+// sleepMaskIndex maps the sleep-mask string onto the KH_SLEEP_MASK value. The
+// in-server default (when the client sends nothing recognized) is 3.
+func sleepMaskIndex(s string) int {
+	switch strings.ToLower(s) {
+	case "timer":
+		return 1
+	case "pooling":
+		return 2
+	default:
+		return 3
+	}
+}

