+// TestBuildViaSidecarThroughFakeBuilder wires buildViaSidecar at an in-process
+// fake builder (via ModuleDir/kharon_builder_socket) and asserts the repacked
+// payload/filename match the canned response.
+func TestBuildViaSidecarThroughFakeBuilder(t *testing.T) {
+	dir := t.TempDir()
+	sockPath := "/tmp/kharon_sidecar_test.sock" // short path: macOS sun_path is capped at 104 bytes
+	if err := os.WriteFile(filepath.Join(dir, "kharon_builder_socket"), []byte(sockPath), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	origModuleDir := ModuleDir
+	ModuleDir = dir
+	t.Cleanup(func() {
+		ModuleDir = origModuleDir
+		_ = os.Remove(sockPath)
+	})
+
+	fakeKharonBuilder(t, sockPath, nil)
+
+	resp, name, err := buildViaSidecar(&kharonbuilder.KharonBuildRequest{Target: "x64", OutputFormat: "exe"})
+	if err != nil {
+		t.Fatalf("buildViaSidecar: %v", err)
+	}
+	if name != "Kharon.x64.exe" {
+		t.Fatalf("filename = %q, want %q", name, "Kharon.x64.exe")
+	}
+	if string(resp) != "FAKEKHARONPAYLOAD" {
+		t.Fatalf("payload = %q, want %q", string(resp), "FAKEKHARONPAYLOAD")
+	}
+}
