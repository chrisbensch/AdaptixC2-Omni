+// TestBuildViaSidecarCapturesRequest asserts the server derives the request fields
+// the worker relies on (target, output format, and the make-variable fields) and
+// forwards them verbatim over the socket.
+func TestBuildViaSidecarCapturesRequest(t *testing.T) {
+	dir := t.TempDir()
+	sockPath := "/tmp/kharon_sidecar_test.sock"
+	if err := os.WriteFile(filepath.Join(dir, "kharon_builder_socket"), []byte(sockPath), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	origModuleDir := ModuleDir
+	ModuleDir = dir
+	t.Cleanup(func() {
+		ModuleDir = origModuleDir
+		_ = os.Remove(sockPath)
+	})
+
+	var got *kharonbuilder.KharonBuildRequest
+	fakeKharonBuilder(t, sockPath, &got)
+
+	wantReq := &kharonbuilder.KharonBuildRequest{
+		Target:            "x86",
+		Debug:             true,
+		OutputFormat:      "dll",
+		WebSecureEnabled:  true,
+		WebProxyEnabled:   false,
+		WebProxyURL:       "http://proxy:8080",
+		KhSleepTime:       "5",
+		KhJitter:          20,
+		KhAgentUUID:       "agent-uuid",
+		KhWorktimeEnabled: true,
+		KhWorktimeStartH:  8,
+		KhWorktimeStartM:  30,
+		KhWorktimeEndH:    17,
+		KhWorktimeEndM:    0,
+		KhKilldateEnabled: true,
+		KhKilldateDay:     15,
+		KhKilldateMonth:   6,
+		KhKilldateYear:    2027,
+		KhForkPipeName:    `pipe\name`,
+		KhSpawnto:         `notepad.exe`,
+		KhBofHookEnabled:  true,
+		HTTPMalleableHex:  "deadbeef",
+		HTTPCallbackCount: 3,
+		KhGuardrailUser:   "svc",
+		KhGuardrailDomain: "corp.local",
+		KhGuardrailHost:   "host",
+		KhGuardrailIP:     "10.0.0.1",
+		KhSyscall:         2,
+		KhAmsiEtwBypass:   0x3,
+		KhHeapMask:        true,
+		KhSleepMask:       1,
+	}
+
+	if _, _, err := buildViaSidecar(wantReq); err != nil {
+		t.Fatalf("buildViaSidecar: %v", err)
+	}
+	if got == nil {
+		t.Fatal("fake builder never received a request")
+	}
+	// Deep-compare every field the worker maps onto the make invocation + build
+	// selection; a mismatch means the beacon won't compile/parse the profile.
+	if *got != *wantReq {
+		t.Fatalf("captured request mismatch:\n got  %+v\n want %+v", *got, *wantReq)
+	}
+}
